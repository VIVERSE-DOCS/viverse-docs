    "profile"
  ],
  "prerequisites": [
    "Unity 2021.2+",
    "Auth token (for user-specific APIs)",
    "UniVRM v0.130.1+ (for VRM loading only)"
  ],
  "entrypoint": "SKILL.md",
  "rules": "rules.json",
  "patterns_dir": "patterns",
  "read_order": [
    "SKILL.md",
    "patterns/dual-path-avatar.md",
    "patterns/vrm-loading.md"
  ],
  "dependencies": [
    "viverse-unity-auth"
  ]
}
